# Copy into .env and fill in. Format: NAME=value (no spaces around =, no quotes). Names only here (test S37).
# Never commit .env and never paste secrets in chat.

# Supabase kleeno-dev. Key = SECRET key (sb_secret_...), not the publishable one.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase publishable key + URL. Public by design: safe only because anon has no table rights and authenticated is read-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase kleeno-prod (used from P2, for Vercel).
SUPABASE_PROD_URL=
SUPABASE_PROD_SERVICE_ROLE_KEY=

# OpenRouter key with a $5 spend cap.
# Optional (add the line only to change it): OPENROUTER_MODEL (default z-ai/glm-5.3-flash), OPENROUTER_FALLBACK_MODEL.
OPENROUTER_API_KEY=

# Circle console with the Testnet toggle on. API key must start with TEST_API_KEY:. Entity secret = 64 hex characters.
# ARC_RPC_URL: https://rpc.testnet.arc.network
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
ARC_RPC_URL=

# Random secrets you generate (used from P2), 32 random bytes each.
RECEIPT_HMAC_SECRET=
# 32 bytes as 64 hex characters or base64. While rotating, add DATA_ENCRYPTION_KEY_PREVIOUS (the old key, e.g. v1:<key>) and set the new one as v2:<key>.
DATA_ENCRYPTION_KEY=

# The two human logins for the app. Different people (four-eyes rule). Passwords 12+ characters, different from each other.
PAYROLL_APPROVER_EMAIL=
PAYROLL_APPROVER_PASSWORD=
PAYMENT_APPROVER_EMAIL=
PAYMENT_APPROVER_PASSWORD=

# Waitlist + lead list (docs/phases/W.md).
# SITE_MODE: "app" opens the payroll app; anything else (or missing) = waitlist only. Vercel Production: leave unset until P5.
# ADMIN_PATH: 24-64 lowercase letters/digits; the private admin area lives at /<ADMIN_PATH>. Never commit or share it.
# WAITLIST_SECRET: >= 32 random characters (keys the rate-limit hashes).
# SITE_URL: canonical public URL, e.g. https://kleeno.orclide.com. CONTACT_EMAIL: shown on /privacy for deletion requests.
SITE_MODE=
ADMIN_PATH=
WAITLIST_SECRET=
SITE_URL=
CONTACT_EMAIL=
# Used only by scripts/add-platform-admin.ts.
ADMIN_EMAIL=
ADMIN_PASSWORD=
